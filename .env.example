# Mayson Target Application Configuration
MAYSON_BASE_URL=https://app.mayson.ai
MAYSON_USERNAME=monitor-user@example.com
MAYSON_PASSWORD=your_secure_password_if_needed

# Email IMAP Configuration for OTP Retrieval
MAIL_HOST=imap.gmail.com
MAIL_PORT=993
MAIL_USERNAME=monitor-user@example.com
MAIL_PASSWORD=your_email_app_password
MAIL_USE_SSL=true

# Optional OTP Email Filters
OTP_EMAIL_SENDER=no-reply@mayson.ai
OTP_EMAIL_SUBJECT=Your Mayson Login Verification Code
