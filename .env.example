# Mayson API Target Configuration
MAYSON_BASE_URL=https://cc1fbde45ead-in-south-01.mayson.dev
MAYSON_EMAIL=monitoring@example.com
MAYSON_CURRENT_IP=127.0.0.1

# IMAP Mailbox Configuration (For reading OTP email)
MAIL_HOST=imap.example.com
MAIL_PORT=993
MAIL_USERNAME=monitoring@example.com
MAIL_PASSWORD=your_imap_app_password
MAIL_USE_SSL=true

# OTP Email Filtering & Polling Settings
OTP_EMAIL_SENDER=no-reply@mayson.dev
OTP_EMAIL_SUBJECT=One-Time Password
OTP_TIMEOUT_SECONDS=60
OTP_POLL_INTERVAL_SECONDS=3

# SMTP Alerting Configuration (For sending failure/recovery alerts)
ALERT_SMTP_HOST=smtp.example.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=alerts@example.com
ALERT_SMTP_PASSWORD=your_smtp_password
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=oncall@example.com
ALERT_SMTP_USE_SSL=false
